# ===== CẤU HÌNH MÔI TRƯỜNG =====
# development | production | testing
FLASK_ENV=development

# Khóa bí mật ký session/CSRF. PRODUCTION BẮT BUỘC đặt chuỗi ngẫu nhiên, dài, bí mật.
# Sinh nhanh: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=doi_thanh_chuoi_ngau_nhien_bi_mat

# Chỉ bật True khi chạy sau HTTPS (production). Để False khi chạy http://localhost.
SESSION_COOKIE_SECURE=False

# Dung lượng file PDF tối đa (byte). 52428800 = 50MB
MAX_FILE_SIZE=52428800

# ===== CẤU HÌNH CƠ SỞ DỮ LIỆU (MySQL) =====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=taocauhoiai
# Số kết nối giữ sẵn trong connection pool
DB_POOL_SIZE=10

# ===== TRÍ TUỆ NHÂN TẠO (Google Gemini) =====
GEMINI_API_KEY=nhap_api_key_cua_ban_vao_day

# ===== MÃ MỜI GIÁO VIÊN =====
# Chỉ ai có mã này mới đăng ký được vai trò Giáo viên.
GIAO_VIEN_CODE=doi_ma_bi_mat_cua_ban

# ===== URL CÔNG KHAI =====
# Tên miền thật, dùng cho link mời vào phòng thi. VD: https://stewiequiz.io.vn
# Để trống nếu chạy nội bộ (link sẽ lấy theo host đang truy cập).
PUBLIC_BASE_URL=

# ===== REALTIME (Socket.IO) =====
# Production: chỉ cho phép chính tên miền của mình kết nối (chống trang khác nhúng lén).
# Nhiều tên miền thì ngăn cách bằng dấu phẩy. Để trống = cho phép tất cả (chỉ nên dùng khi dev).
CORS_ORIGINS=https://stewiequiz.io.vn

# ===== GIỚI HẠN TẦN SUẤT (rate limit) =====
# memory:// chỉ đúng khi chạy MỘT tiến trình web. Nếu chạy nhiều worker thì phải
# dùng Redis, ví dụ: redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# ===== GỬI EMAIL XÁC MINH/ĐẶT LẠI MẬT KHẨU (OTP) — SMTP Gmail =====
# EMAIL_APP_PASSWORD là "App Password" 16 ký tự (cần bật 2FA), KHÔNG phải mật khẩu Gmail.
# Bắt buộc cấu hình thì luồng "Quên mật khẩu" mới hoạt động.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# ===== DỌN RÁC ĐỊNH KỲ (cleanup.py) =====
# Số ngày giữ ảnh webcam giám sát trước khi tự xóa
PROCTOR_RETENTION_DAYS=7
# Số giờ giữ file PDF tạm trong uploads/ trước khi dọn
UPLOAD_TMP_HOURS=24
